{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts"
  ],
  "out": "docs",
  "readme": "README.md",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "exclude": [
    "src/ontologies/**"
  ],
  "sort": [
    "alphabetical"
  ],
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "turtle",
    "yaml",
    "tsx",
    "typescript"
  ],
  "plugin": [],
  "tsconfig": "tsconfig.json"
}